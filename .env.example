# baan_laundry_api
#
# Local development — คัดลอกเป็น `.env`
#   cp .env.example .env
#
# Docker / Jenkins — ส่งผ่าน env หรือ parameter (ไม่ควร bake secret เข้า image)
#   API_PORT=3001
#   CORS_ORIGIN=http://187.52.125.210:3000
#   DATABASE_URL=postgres://postgres:root@host.docker.internal:5432/baan_laundry
#   JWT_SECRET=<strong-secret>

PORT=3001
NODE_ENV=production

# Postgres
DATABASE_URL=postgres://postgres:root@localhost:5432/baan_laundry
# หรือแยก field (ใช้เมื่อไม่มี DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=root
DB_NAME=baan_laundry

JWT_SECRET=change-me-to-a-long-random-string

# frontend admin origin (คั่นด้วย comma ได้)
CORS_ORIGIN=http://localhost:3000
